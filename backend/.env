# ==============================================================================
# CRATE Analytics Backend Environment Configuration
# Paste your actual tokens and credentials below when ready.
# ==============================================================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# PostgreSQL Database Connection String (Prisma ORM)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crate_db?schema=public"

# GitHub Personal Access Token (PAT)
# Increases GitHub API rate limit from 60 to 5,000 requests/hour
# Paste your token starting with ghp_ or github_pat_ below:
GITHUB_TOKEN=""

# GitHub OAuth Credentials (For User Authentication / Login)
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Python ML Microservice URL (FastAPI Service in ml/app.py)
ML_SERVICE_URL="http://localhost:8000"
