  "version": "1.0.0",
  "description": "CRATE - Contributor Retention Analytics and Tracking Engine Backend API Server",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
